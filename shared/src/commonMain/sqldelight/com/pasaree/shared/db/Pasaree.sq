-- Skema lokal Pasaree (offline-first). Uang integer IDR; waktu epoch milidetik UTC.
-- Bayar TIDAK pernah disimpan sebagai aksi antrean (hanya kunci idempotensi 24 jam).

CREATE TABLE keranjang_item (
    varian_id TEXT NOT NULL PRIMARY KEY,
    produk_id TEXT NOT NULL,
    lapak_slug TEXT NOT NULL,
    lapak_nama TEXT NOT NULL,
    judul TEXT NOT NULL,
    nama_varian TEXT NOT NULL,
    harga_idr INTEGER NOT NULL,
    qty INTEGER NOT NULL,
    stok_tersedia INTEGER NOT NULL,
    urutan INTEGER NOT NULL
);

CREATE TABLE cache_katalog (
    kunci TEXT NOT NULL PRIMARY KEY,
    isi TEXT NOT NULL,
    diambil_pada INTEGER NOT NULL
);

CREATE TABLE antrean_aksi (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    jenis TEXT NOT NULL,
    varian_id TEXT NOT NULL,
    qty INTEGER NOT NULL,
    dibuat_pada INTEGER NOT NULL,
    percobaan INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE kunci_idempotensi (
    pesanan_id TEXT NOT NULL,
    metode TEXT NOT NULL,
    kunci TEXT NOT NULL,
    dibuat_pada INTEGER NOT NULL,
    PRIMARY KEY (pesanan_id, metode)
);

CREATE TABLE sync_meta (
    kunci TEXT NOT NULL PRIMARY KEY,
    nilai TEXT NOT NULL
);

semuaKeranjang:
SELECT * FROM keranjang_item ORDER BY urutan ASC;

upsertKeranjang:
INSERT OR REPLACE INTO keranjang_item(varian_id, produk_id, lapak_slug, lapak_nama, judul, nama_varian, harga_idr, qty, stok_tersedia, urutan)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

maksUrutan:
SELECT COALESCE(MAX(urutan), 0) FROM keranjang_item;

hapusKeranjang:
DELETE FROM keranjang_item WHERE varian_id = ?;

kosongkanKeranjang:
DELETE FROM keranjang_item;

ambilCache:
SELECT * FROM cache_katalog WHERE kunci = ?;

simpanCache:
INSERT OR REPLACE INTO cache_katalog(kunci, isi, diambil_pada) VALUES (?, ?, ?);

hapusSemuaCache:
DELETE FROM cache_katalog;

semuaAntrean:
SELECT * FROM antrean_aksi ORDER BY id ASC;

tambahAntrean:
INSERT INTO antrean_aksi(jenis, varian_id, qty, dibuat_pada) VALUES (?, ?, ?, ?);

hapusAntrean:
DELETE FROM antrean_aksi WHERE id = ?;

naikkanPercobaan:
UPDATE antrean_aksi SET percobaan = percobaan + 1 WHERE id = ?;

ambilKunci:
SELECT * FROM kunci_idempotensi WHERE pesanan_id = ? AND metode = ?;

simpanKunci:
INSERT OR REPLACE INTO kunci_idempotensi(pesanan_id, metode, kunci, dibuat_pada) VALUES (?, ?, ?, ?);

hapusKunciPesanan:
DELETE FROM kunci_idempotensi WHERE pesanan_id = ?;

hapusKunciKedaluwarsa:
DELETE FROM kunci_idempotensi WHERE dibuat_pada < ?;

ambilMeta:
SELECT nilai FROM sync_meta WHERE kunci = ?;

simpanMeta:
INSERT OR REPLACE INTO sync_meta(kunci, nilai) VALUES (?, ?);
